{
  "name": "dendro-react",
  "displayName": "Dendro React",
  "publisher": "RooneyTech",
  "icon": "images/dendro.png",
  "galleryBanner": {
    "color": "#0A0E17",
    "theme": "dark"
  },
  "version": "0.8.1",
  "license": "MIT",
  "pricing": "Free",
  "description": "MCP server + VS Code extension for React and React Native component tree visualization. Gives AI assistants deep understanding of your architecture.",
  "repository": {
    "type": "git",
    "url": "https://github.com/RooneyTech/dendro-react"
  },
  "bugs": {
    "url": "https://github.com/RooneyTech/dendro-feedback/issues"
  },
  "homepage": "https://github.com/RooneyTech/dendro-feedback",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Debuggers"
  ],
  "keywords": [
    "react",
    "component tree",
    "visualization",
    "mcp",
    "architecture"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Dendro runs in restricted mode in untrusted workspaces. File scanning, runtime connections, and MCP tools are disabled until trust is granted."
    }
  },
  "main": "./dist/extension.js",
  "bin": {
    "dendro-mcp": "./dist/mcp-server.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dendro-react",
          "title": "Dendro",
          "icon": "images/icons/dendro-activity-bar.svg"
        }
      ]
    },
    "views": {
      "dendro-react": [
        {
          "id": "dendroReactComponentTree",
          "name": "Component Tree",
          "icon": "images/icons/dendro-activity-bar.svg",
          "contextualTitle": "Dendro Component Tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dendroReactComponentTree",
        "contents": "No component tree loaded.\n[Select Root Component](command:dendro-react.selectRootComponent)\nOr right-click a React file and select \"Set as Dendro Root\"\n\nUsing Claude Code or Cursor? [Set up MCP tools](https://marketplace.visualstudio.com/items?itemName=RooneyTech.dendro-react#setup) for AI-powered analysis."
      }
    ],
    "commands": [
      {
        "command": "dendro-react.start",
        "title": "Dendro React: Start"
      },
      {
        "command": "dendro-react.visualize",
        "title": "Dendro React: Visualize Component Tree",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dendro-react.showComponentUsage",
        "title": "Dendro React: Show Component Usage"
      },
      {
        "command": "dendro-react.selectRootComponent",
        "title": "Dendro React: Select Root Component",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dendro-react.setAsRoot",
        "title": "Dendro React: Set as Root Component"
      },
      {
        "command": "dendro-react.refreshTree",
        "title": "Dendro React: Refresh Component Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "dendro-react.openComponent",
        "title": "Dendro React: Open Component"
      },
      {
        "command": "dendro-react.testUri",
        "title": "Dendro React: Test URI Handler"
      },
      {
        "command": "dendro-react.connectRuntime",
        "title": "Dendro React: Connect to Running App",
        "icon": "$(plug)"
      },
      {
        "command": "dendro-react.disconnectRuntime",
        "title": "Dendro React: Disconnect from Running App",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dendro-react.activateLicense",
        "title": "Dendro React: Activate License Key"
      },
      {
        "command": "dendro-react.upgradeToPro",
        "title": "Dendro React: Upgrade to Pro"
      },
      {
        "command": "dendro-react.manageSubscription",
        "title": "Dendro React: Manage Subscription"
      },
      {
        "command": "dendro-react.deactivateLicense",
        "title": "Dendro React: Deactivate License"
      },
      {
        "command": "dendro-react.licenseStatus",
        "title": "Dendro React: License Status"
      },
      {
        "command": "dendro-react.showRuntimeTree",
        "title": "Dendro React: Show Live Runtime Tree",
        "icon": "$(radio-tower)"
      },
      {
        "command": "dendro-react.projectorMode",
        "title": "Dendro React: Toggle Projector Mode",
        "icon": "$(screen-full)"
      },
      {
        "command": "dendro-react.reportIssue",
        "title": "Dendro React: Report Issue",
        "icon": "$(comment)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dendro-react.testUri",
          "when": "config.dendro-react.devMode"
        },
        {
          "command": "dendro-react.activateLicense",
          "when": "config.dendro-react.devMode"
        },
        {
          "command": "dendro-react.upgradeToPro",
          "when": "config.dendro-react.devMode"
        },
        {
          "command": "dendro-react.manageSubscription",
          "when": "config.dendro-react.devMode"
        },
        {
          "command": "dendro-react.deactivateLicense",
          "when": "config.dendro-react.devMode"
        },
        {
          "command": "dendro-react.licenseStatus",
          "when": "config.dendro-react.devMode"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == typescriptreact || resourceLangId == javascriptreact || resourceExtname == .tsx || resourceExtname == .jsx",
          "command": "dendro-react.visualize",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == typescriptreact || resourceLangId == javascriptreact || resourceExtname == .tsx || resourceExtname == .jsx",
          "command": "dendro-react.setAsRoot",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceLangId == typescriptreact || resourceLangId == javascriptreact || resourceExtname == .tsx || resourceExtname == .jsx",
          "command": "dendro-react.visualize",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == typescriptreact || resourceLangId == javascriptreact || resourceExtname == .tsx || resourceExtname == .jsx",
          "command": "dendro-react.setAsRoot",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "dendro-react.selectRootComponent",
          "when": "view == dendroReactComponentTree",
          "group": "navigation@1"
        },
        {
          "command": "dendro-react.refreshTree",
          "when": "view == dendroReactComponentTree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dendro-react.visualize",
          "when": "view == dendroReactComponentTree && viewItem == component",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dendro-react.visualize",
        "key": "shift+alt+d",
        "mac": "shift+alt+d",
        "when": "editorTextFocus && resourceLangId =~ /typescriptreact|javascriptreact/"
      }
    ],
    "configuration": {
      "title": "Dendro React",
      "properties": {
        "dendro-react.runtimePlatform": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "ios",
            "android",
            "device"
          ],
          "enumDescriptions": [
            "Auto-detect: sets up Android ADB tunnel silently if adb is available",
            "iOS Simulator only (localhost, no tunnel needed)",
            "Android Emulator: runs 'adb reverse' to tunnel port 8097",
            "Physical device: listens on 0.0.0.0 so devices on the same network can connect"
          ],
          "description": "Target platform for runtime connection. Use 'device' for physical phones on the same network."
        },
        "dendro-react.runtimePort": {
          "type": "number",
          "default": 8097,
          "description": "Port for the React DevTools WebSocket server (default: 8097)"
        },
        "dendro-react.runtimeHost": {
          "type": "string",
          "default": "localhost",
          "description": "Host to bind the WebSocket server to. Use '0.0.0.0' for physical device support (or set platform to 'device'). Default: localhost"
        },
        "dendro-react.autoStartRuntime": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start listening for React Native apps on activation. When false (default), use 'Dendro React: Connect to Running App' to start manually."
        },
        "dendro-react.projectorMode": {
          "type": "boolean",
          "default": false,
          "description": "Increase font sizes and stroke widths for projector/screen-share readability"
        },
        "dendro-react.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable developer/debug commands (e.g. Test URI Handler). Not intended for end users."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "build": "npm run compile && webpack --config webpack.config.js",
    "build:prod": "npm run compile && webpack --config webpack.prod.js",
    "build:free": "npm run compile && webpack --config webpack.free.js",
    "compile": "tsc -p ./tsconfig.json",
    "webpack": "webpack",
    "watch": "concurrently \"webpack --watch\" \"tsc -watch -p ./tsconfig.json\"",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "test:pro": "node scripts/test-pro-features.js",
    "test:runtime": "node scripts/test-runtime-features.js",
    "test:all": "node scripts/test-all.js",
    "test:e2e": "npm run test:e2e:mcp && npm run test:e2e:webview",
    "test:e2e:mcp": "npm run build && node e2e/tier2-mcp/mcp-server.e2e.js",
    "test:e2e:webview": "npm run build && node e2e/tier3-webview/webview.e2e.js",
    "test:e2e:extension": "npm run compile && npx tsc -p e2e/tier1-extension/tsconfig.json && node out/e2e/tier1-extension/runTest.js",
    "test:e2e:capture": "node .dev/capture/e2e-features.js",
    "capture:fixtures": "node .dev/capture/generate-fixtures.js",
    "capture:screenshots": "node .dev/capture/capture-screenshots.js",
    "capture:gifs": "node .dev/capture/capture-gifs.js",
    "capture:all": "npm run capture:screenshots && npm run capture:gifs"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.8",
    "@babel/plugin-syntax-import-attributes": "^7.25.9",
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.16.13",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.1.0",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.13.0",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-react": "^7.36.1",
    "glob": "^11.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^25.0.1",
    "ovsx": "^1.1.1",
    "playwright": "^1.50.0",
    "typescript": "^5.6.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "d3": "^7.9.0",
    "lru-cache": "^11.2.5",
    "oxc-parser": "^0.111.0",
    "react": "^18.3.1",
    "react-devtools-core": "^7.0.1",
    "react-dom": "^18.3.1",
    "ts-morph": "^27.0.2",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  }
}
